[Desktop Entry]
Type=Application
Name=quota-watch
Name[zh_CN]=配置重置提醒
GenericName=Reset Countdown Reminder
GenericName[zh_CN]=重置周期倒计时提醒
Comment=Countdown reminders for service reset cycles
